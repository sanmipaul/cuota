PORT=8787
BASE_URL=https://cuota.example.com
DB_PATH=./cuota.db
# Back the SQLite file up to Postgres (hosts without a persistent disk)
DATABASE_URL=
TICK_SECONDS=300

# Celo mainnet
RPC_URL=https://forno.celo.org
AGENT_KEY=0x...
# from `npm run deploy`
CONTRACT=
CONTRACT_FROM_BLOCK=

# ERC-8021 builder code from hackathon enrollment
BUILDER_CODE=
# ERC-8004 agent id from `npm run register`
AGENT_ID=

# Celo hosted x402 facilitator (USA₮ pay links for foreign payers)
X402_URL=https://api.x402.celo.org
X402_KEY=

# Textile FX (optional partner key; otherwise a TakerControl signature is used)
TEXTILE_URL=https://api.textilecredit.com/v2
TEXTILE_KEY=
FX_TOLERANCE_BPS=200

# buy: Chainstack RPC batches + Cencori notices, paid in USDC/USD₮ from the agent wallet
BUY_BUDGET_USD_PER_DAY=1.5

# notices are POSTed here for delivery (Telegram/WhatsApp bridge, email worker)
NOTIFY_WEBHOOK=
ADMIN_TOKEN=change-me-to-a-long-random-string
